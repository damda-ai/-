        <div class="hero-visual">
          <img src="photo4.jpg" alt="당일 신선한 재료로 정갈하게 담아낸 도시락담다 수제 도시락" />
          <div class="hero-visual-tag">
            <div>당일 신선 조리 · 1:1 예산 맞춤</div>
            <span>10분 내 견적 안내</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 핵심 신뢰 지표 바 -->
  <div class="wrap stats-wrap">
    <div class="stats-grid">
      <div class="stat-item">
        <div class="stat-num"><em>10 ~ 500</em>개</div>
        <div class="stat-label">소량부터 대량 단체 OK</div>
      </div>
      <div class="stat-item">
        <div class="stat-num"><em>10분</em> 내</div>
        <div class="stat-label">예산·수량 맞춤 견적 발송</div>
      </div>
