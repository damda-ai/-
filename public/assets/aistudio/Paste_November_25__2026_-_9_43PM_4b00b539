  <script>
    // 메뉴 카테고리 탭 필터
    const tabs = document.querySelectorAll('.menu-tab');
    const cards = document.querySelectorAll('.menu-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const filter = tab.dataset.filter;

        cards.forEach(card => {
          if (filter === 'all' || card.dataset.category === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    // 메뉴 견적 담기 기능
    const pickedMenus = [];
    const menuInput = document.getElementById('selectedMenuInput');
    const toast = document.getElementById('toast');
    let toastTimer;

    function showToast(msg) {
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('show'), 2000);
    }

    function pickMenu(btn, menuTitle) {
      const idx = pickedMenus.indexOf(menuTitle);
      if (idx === -1) {
        pickedMenus.push(menuTitle);
        btn.classList.add('picked');
        btn.textContent = '✓ 담김';
        showToast('견적 신청서에 담겼습니다.');
      } else {
        pickedMenus.splice(idx, 1);
        btn.classList.remove('picked');
        btn.textContent = '+ 견적 담기';
        showToast('선택이 해제되었습니다.');
      }
      menuInput.value = pickedMenus.join(', ');
    }

    // 폼 접수 알림 (실제 전송 연동 전 안내)
    function submitQuote(e) {
